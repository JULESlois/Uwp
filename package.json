{
  "name": "uwp_components",
  "private": true,
  "version": "0.1.1",
  "description": "Typed React components and interaction patterns inspired by Windows 8 Modern UI and Windows 10 / early UWP.",
  "type": "module",
  "files": [
    "dist-lib"
  ],
  "main": "./dist-lib/index.js",
  "module": "./dist-lib/index.js",
  "types": "./dist-lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist-lib/index.d.ts",
      "import": "./dist-lib/index.js"
    },
    "./controls": {
      "types": "./dist-lib/entrypoints/controls.d.ts",
      "import": "./dist-lib/controls.js"
    },
    "./commands": {
      "types": "./dist-lib/entrypoints/commands.d.ts",
      "import": "./dist-lib/commands.js"
    },
    "./navigation": {
      "types": "./dist-lib/entrypoints/navigation.d.ts",
      "import": "./dist-lib/navigation.js"
    },
    "./collections": {
      "types": "./dist-lib/entrypoints/collections.d.ts",
      "import": "./dist-lib/collections.js"
    },
    "./overlays": {
      "types": "./dist-lib/entrypoints/overlays.d.ts",
      "import": "./dist-lib/overlays.js"
    },
    "./styles.css": "./dist-lib/styles.css",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JULESlois/Uwp.git"
  },
  "homepage": "https://github.com/JULESlois/Uwp#readme",
  "bugs": {
    "url": "https://github.com/JULESlois/Uwp/issues"
  },
  "keywords": [
    "react",
    "typescript",
    "uwp",
    "windows",
    "modern-ui",
    "metro",
    "ui-components",
    "design-system"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "vite",
    "dev:example": "vite --config vite.example.config.ts",
    "test": "vitest run",
    "build": "tsc -b && vite build",
    "build:lib": "vite build --config vite.lib.config.ts && tsc -p tsconfig.lib.json",
    "build:example": "tsc -p tsconfig.example.json && vite build --config vite.example.config.ts",
    "package:stage": "npm run build:lib && node scripts/prepare-npm-package.mjs && node scripts/verify-npm-package.mjs",
    "pack:check": "npm run package:stage && npm pack ./npm-package --dry-run --json",
    "release:check": "node scripts/verify-release.mjs",
    "stage:npm": "npm run package:stage && npm stage publish ./npm-package --access public",
    "preview": "vite preview"
  },
  "peerDependencies": {
    "react": ">=18.3.1 <20",
    "react-dom": ">=18.3.1 <20"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "jsdom": "^26.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.9"
  }
}
